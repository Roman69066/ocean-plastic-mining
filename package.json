{
  "name": "ocean-plastic-mining",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:routes": "node scripts/check-routes.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write app components lib scripts tests",
    "sync:toolkit": "node scripts/sync-toolkit.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.10.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.58.2",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.7.2"
  }
}
