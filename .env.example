# Optional public configuration. No secrets are needed to build or run.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repository
# First public launch, fixed across redeployments; leave unset before launch.
# NEXT_PUBLIC_SITE_LAUNCHED_AT=2026-09-12T00:00:00Z
# Optional durable visitor counter (Upstash-compatible Redis REST). Server-only secrets:
COUNTER_REDIS_REST_URL=
COUNTER_REDIS_REST_TOKEN=
# Use separate namespaces for preview and production.
COUNTER_NAMESPACE=opm-production
